<Window x:Class="VietVoiceReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VietVoice Reader"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#DADADC"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Compact Sumatra-like toolbar -->
    <Border Grid.Row="0"
            Background="#F7F7F7"
            BorderBrush="#CFCFD2"
            BorderThickness="0,0,0,1"
            Padding="3">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Click="ToggleNavigationPane_Click"
                  Content="☰"
                  ToolTip="Thư viện / Mục lục / Tìm kiếm"
                  Width="32"/>
          <Button x:Name="OpenBookButton"
                  Click="OpenBook_Click"
                  Content="Mở"
                  ToolTip="Mở EPUB"/>

          <Separator Margin="5,2" Width="1"/>

          <Button x:Name="PrevChapterButton"
                  Click="PrevChapter_Click"
                  Content="‹"
                  FontSize="18"
                  ToolTip="Chương trước"
                  Width="32"/>
          <ComboBox x:Name="ChapterJumpCombo"
                    Width="230"
                    SelectionChanged="ChapterJumpCombo_SelectionChanged"
                    ToolTip="Chọn chương"/>
          <Button x:Name="NextChapterButton"
                  Click="NextChapter_Click"
                  Content="›"
                  FontSize="18"
                  ToolTip="Chương sau"
                  Width="32"/>

          <Separator Margin="5,2" Width="1"/>

          <TextBlock Text="Trang"
                     VerticalAlignment="Center"
                     Margin="4,0,2,0"/>
          <TextBox x:Name="PageNumberBox"
                   Width="46"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   KeyDown="PageNumberBox_KeyDown"/>
          <Button Click="GoToPage_Click"
                  Content="Đi"
                  Width="34"/>

          <Separator Margin="5,2" Width="1"/>

          <Button x:Name="PlayButton"
                  Click="Play_Click"
                  Content="▶"
                  ToolTip="Đọc"/>
          <Button x:Name="StopButton"
                  Click="Stop_Click"
                  Content="■"
                  ToolTip="Dừng"/>

          <CheckBox x:Name="AutoNextCheckBox"
                    Content="Tự qua chương"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    Margin="6,0,4,0"/>

          <Button x:Name="BookmarkButton"
                  Click="AddBookmark_Click"
                  Content="★"
                  ToolTip="Thêm dấu trang"/>
          <Button Click="ToggleSettingsPane_Click"
                  Content="Aa"
                  ToolTip="Giọng đọc và hiển thị"
                  MinWidth="34"/>
          <Button x:Name="ExportButton"
                  Click="Export_Click"
                  Content="MP3"
                  ToolTip="Xuất MP3"/>

          <!-- Kept for code-behind compatibility; compact layout already acts as focus mode -->
          <Button x:Name="FocusModeButton"
                  Click="FocusMode_Click"
                  Content="Tập trung"
                  Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock x:Name="BookTitleText"
                   Text="Kéo EPUB vào cửa sổ để mở"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Foreground="#555"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="10,0,6,0"/>
      </DockPanel>
    </Border>

    <Grid x:Name="ReaderLayoutGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="0"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="RightColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- Navigation drawer: hidden by default -->
      <Border x:Name="LeftPane"
              Grid.Column="0"
              Visibility="Collapsed"
              Background="#FAFAFA"
              BorderBrush="#CFCFD2"
              BorderThickness="0,0,1,0">
        <TabControl x:Name="LeftTabs"
                    BorderThickness="0"
                    Background="Transparent"
                    Margin="4">
          <TabItem Header="Thư viện">
            <DockPanel Margin="5">
              <StackPanel DockPanel.Dock="Bottom"
                          Orientation="Horizontal"
                          Margin="0,6,0,0">
                <Button Click="ContinueBook_Click" Content="Đọc tiếp"/>
                <Button Click="RemoveFromLibrary_Click" Content="Bỏ khỏi thư viện"/>
              </StackPanel>
              <ListBox x:Name="LibraryList"
                       BorderThickness="0"
                       Background="Transparent"
                       MouseDoubleClick="LibraryList_MouseDoubleClick"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="7" Margin="0,0,0,5" Background="#EEEEF0">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Author}"
                                   Foreground="#777"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastReadText}"
                                   Foreground="#4F6BED"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Mục lục">
            <ListBox x:Name="ChapterList"
                     Margin="5"
                     SelectionChanged="ChapterList_SelectionChanged"
                     BorderThickness="0"
                     Background="Transparent"/>
          </TabItem>

          <TabItem Header="Dấu trang">
            <DockPanel Margin="5">
              <StackPanel DockPanel.Dock="Bottom"
                          Orientation="Horizontal"
                          Margin="0,6,0,0">
                <Button Click="OpenBookmark_Click" Content="Mở"/>
                <Button Click="DeleteBookmark_Click" Content="Xóa"/>
              </StackPanel>
              <ListBox x:Name="BookmarkList"
                       BorderThickness="0"
                       Background="Transparent"
                       MouseDoubleClick="BookmarkList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="7" Margin="0,0,0,5" Background="#EEEEF0">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayTitle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DisplayDetail}"
                                   Foreground="#777"
                                   FontSize="11"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Tìm">
            <DockPanel Margin="5">
              <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                  <Button DockPanel.Dock="Right"
                          Click="SearchBook_Click"
                          Content="Tìm"/>
                  <TextBox x:Name="SearchBox"
                           Margin="0,0,4,0"
                           VerticalContentAlignment="Center"
                           KeyDown="SearchBox_KeyDown"/>
                </DockPanel>
                <TextBlock x:Name="SearchSummaryText"
                           Foreground="#777"
                           FontSize="11"
                           Margin="2,4,2,6"/>
              </StackPanel>
              <ListBox x:Name="SearchResultsList"
                       BorderThickness="0"
                       Background="Transparent"
                       MouseDoubleClick="SearchResults_MouseDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="7" Margin="0,0,0,5" Background="#EEEEF0">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayTitle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Snippet}"
                                   Foreground="#666"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>

      <!-- Reading canvas -->
      <Grid Grid.Column="1" Background="#DADADC">
        <TabControl x:Name="BookTabs"
                    Margin="0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="BookTabs_SelectionChanged"/>

        <TextBlock x:Name="EmptyHint"
                   Text="Kéo một hoặc nhiều file EPUB vào đây&#x0a;hoặc bấm Mở"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="20"
                   Foreground="#888"
                   IsHitTestVisible="False"/>
      </Grid>

      <!-- Settings drawer: hidden by default -->
      <ScrollViewer x:Name="RightPane"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Background="#FAFAFA"
                    BorderBrush="#CFCFD2"
                    BorderThickness="1,0,0,0"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <TextBlock Text="GIỌNG ĐỌC"
                     FontWeight="Bold"
                     Foreground="#555"/>
          <ComboBox x:Name="VoiceCombo"
                    SelectionChanged="VoiceCombo_SelectionChanged"/>
          <TextBlock x:Name="VoiceSourceText"
                     Foreground="#666"
                     FontSize="11"
                     TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <Button x:Name="DownloadVoiceButton"
                    Click="DownloadVoice_Click"
                    Content="Tải giọng"/>
            <Button x:Name="RemoveVoiceButton"
                    Click="RemoveVoice_Click"
                    Content="Xóa model"/>
          </StackPanel>

          <TextBlock Text="Tốc độ đọc"/>
          <DockPanel Margin="0,2,0,8">
            <TextBlock x:Name="SpeedText"
                       DockPanel.Dock="Right"
                       Width="46"
                       Text="1.00x"
                       VerticalAlignment="Center"/>
            <Slider x:Name="SpeedSlider"
                    Minimum="0.65"
                    Maximum="1.7"
                    Value="1"
                    TickFrequency="0.05"
                    ValueChanged="SpeedSlider_ValueChanged"/>
          </DockPanel>

          <Separator Margin="0,5,0,8"/>

          <TextBlock Text="HIỂN THỊ"
                     FontWeight="Bold"
                     Foreground="#555"/>

          <!-- Old font zoom is intentionally disabled: frame width and font size are separate. -->
          <Slider x:Name="ReaderZoomSlider"
                  Visibility="Collapsed"
                  Minimum="100"
                  Maximum="100"
                  Value="100"
                  ValueChanged="ReaderZoomSlider_ValueChanged"/>
          <TextBlock x:Name="ReaderZoomText"
                     Visibility="Collapsed"
                     Text="100%"/>

          <TextBlock Text="Độ rộng khung đọc"/>
          <DockPanel Margin="0,2,0,6">
            <Button DockPanel.Dock="Right"
                    Click="ReaderWidthFit_Click"
                    Content="Vừa ngang"
                    Margin="5,0,0,0"/>
            <TextBlock x:Name="ReaderWidthText"
                       DockPanel.Dock="Right"
                       Width="48"
                       Text="100%"
                       VerticalAlignment="Center"
                       TextAlignment="Right"/>
            <Slider x:Name="ReaderWidthSlider"
                    Minimum="35"
                    Maximum="100"
                    Value="100"
                    TickFrequency="5"
                    ValueChanged="ReaderWidthSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Lề trái / phải"/>
          <DockPanel Margin="0,2,0,6">
            <TextBlock x:Name="PageMarginText"
                       DockPanel.Dock="Right"
                       Width="48"
                       Text="44 px"
                       VerticalAlignment="Center"
                       TextAlignment="Right"/>
            <Slider x:Name="PageMarginSlider"
                    Minimum="8"
                    Maximum="120"
                    Value="44"
                    TickFrequency="4"
                    ValueChanged="PageMarginSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Căn chữ"/>
          <ComboBox x:Name="TextAlignmentCombo"
                    SelectionChanged="TextAlignmentCombo_SelectionChanged">
            <ComboBoxItem Content="Căn đều"/>
            <ComboBoxItem Content="Căn trái"/>
          </ComboBox>

          <TextBlock Text="Font"/>
          <ComboBox x:Name="FontCombo"
                    SelectionChanged="FontCombo_SelectionChanged"/>
          <Button Click="ImportFont_Click"
                  Content="Nạp font .TTF / .OTF"
                  HorizontalAlignment="Left"/>

          <TextBlock Text="Cỡ chữ" Margin="0,7,0,0"/>
          <DockPanel Margin="0,2,0,6">
            <TextBlock x:Name="FontSizeText"
                       DockPanel.Dock="Right"
                       Width="40"
                       Text="20"
                       VerticalAlignment="Center"/>
            <Slider x:Name="FontSizeSlider"
                    Minimum="12"
                    Maximum="42"
                    Value="20"
                    TickFrequency="1"
                    ValueChanged="FontSizeSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Giãn dòng"/>
          <DockPanel Margin="0,2,0,6">
            <TextBlock x:Name="LineHeightText"
                       DockPanel.Dock="Right"
                       Width="40"
                       Text="32"
                       VerticalAlignment="Center"/>
            <Slider x:Name="LineHeightSlider"
                    Minimum="20"
                    Maximum="60"
                    Value="32"
                    TickFrequency="1"
                    ValueChanged="LineHeightSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Nền đọc"/>
          <ComboBox x:Name="ThemeCombo"
                    SelectionChanged="ThemeCombo_SelectionChanged">
            <ComboBoxItem Content="Sáng"/>
            <ComboBoxItem Content="Tối"/>
            <ComboBoxItem Content="Sepia"/>
          </ComboBox>

          <TextBlock Text="Chế độ"/>
          <ComboBox x:Name="ViewModeCombo"
                    SelectionChanged="ViewModeCombo_SelectionChanged">
            <ComboBoxItem Content="Cuộn"/>
            <ComboBoxItem Content="1 trang"/>
            <ComboBoxItem Content="2 trang"/>
          </ComboBox>

          <TextBlock Text="Ctrl + lăn chuột: nới/thu khung đọc. Font chỉ đổi ở mục Cỡ chữ. ←/→: đổi chương."
                     Foreground="#777"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Margin="0,7,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Thin status / progress bar -->
    <Border Grid.Row="2"
            Background="#F7F7F7"
            BorderBrush="#CFCFD2"
            BorderThickness="0,1,0,0"
            Padding="5,2">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusText"
                   Text="Sẵn sàng"
                   FontSize="11"
                   Foreground="#555"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>

        <Slider x:Name="BookProgressSlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="100"
                Value="0"
                Height="18"
                PreviewMouseLeftButtonUp="BookProgressSlider_MouseLeftButtonUp"/>

        <TextBlock x:Name="BookProgressText"
                   Grid.Column="2"
                   Text="0%"
                   FontSize="11"
                   VerticalAlignment="Center"
                   TextAlignment="Right"
                   Margin="4,0"/>

        <ProgressBar x:Name="Progress"
                     Grid.Column="3"
                     Minimum="0"
                     Maximum="1"
                     Height="6"
                     Value="0"
                     VerticalAlignment="Center"
                     Margin="7,0,0,0"/>

        <!-- Hidden compatibility controls referenced by code-behind -->
        <Button x:Name="MiniPlayButton"
                Grid.Column="3"
                Click="Play_Click"
                Content="▶"
                Visibility="Collapsed"/>
        <Button x:Name="MiniStopButton"
                Grid.Column="3"
                Click="Stop_Click"
                Content="■"
                Visibility="Collapsed"/>
      </Grid>
    </Border>
  </Grid>
</Window>
