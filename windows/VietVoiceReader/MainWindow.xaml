<Window x:Class="VietVoiceReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VietVoice Reader" Width="1440" Height="900" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F5F5F7">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="OpenBookButton" Click="OpenBook_Click" Content="Mở EPUB"/>
          <Button x:Name="PlayButton" Click="Play_Click" Content="Đọc chương"/>
          <Button x:Name="StopButton" Click="Stop_Click" Content="Dừng"/>
          <Button x:Name="ExportButton" Click="Export_Click" Content="Xuất MP3"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <TextBlock x:Name="BookTitleText" Text="Chưa mở sách" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="12,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="310"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="MỤC LỤC" FontWeight="Bold" Foreground="#555" Margin="6,4,6,10"/>
          <ListBox x:Name="ChapterList" SelectionChanged="ChapterList_SelectionChanged" BorderThickness="0" Background="Transparent"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Margin="12" CornerRadius="10" Background="White" BorderBrush="#E2E2E2" BorderThickness="1">
        <FlowDocumentReader x:Name="Reader" ViewingMode="Scroll" IsPrintEnabled="False" IsFindEnabled="True" Margin="14" Background="Transparent"/>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <TextBlock Text="Giọng đọc" FontWeight="Bold" FontSize="18"/>
          <ComboBox x:Name="VoiceCombo" SelectionChanged="VoiceCombo_SelectionChanged"/>
          <TextBlock x:Name="VoiceSourceText" Foreground="#666" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
            <Button x:Name="DownloadVoiceButton" Click="DownloadVoice_Click" Content="Tải giọng"/>
            <Button x:Name="RemoveVoiceButton" Click="RemoveVoice_Click" Content="Xóa model"/>
          </StackPanel>

          <TextBlock Text="Tốc độ đọc" FontWeight="SemiBold"/>
          <DockPanel Margin="0,4,0,12">
            <TextBlock x:Name="SpeedText" DockPanel.Dock="Right" Width="46" Text="1.00x" VerticalAlignment="Center"/>
            <Slider x:Name="SpeedSlider" Minimum="0.65" Maximum="1.7" Value="1" TickFrequency="0.05" ValueChanged="SpeedSlider_ValueChanged"/>
          </DockPanel>

          <Separator Margin="0,4,0,12"/>
          <TextBlock Text="Font & hiển thị" FontWeight="Bold" FontSize="18"/>
          <TextBlock Text="Font chữ" Margin="0,10,0,0"/>
          <ComboBox x:Name="FontCombo" SelectionChanged="FontCombo_SelectionChanged"/>
          <Button Click="ImportFont_Click" Content="Nạp font .TTF / .OTF" HorizontalAlignment="Left"/>

          <TextBlock Text="Cỡ chữ" Margin="0,12,0,0"/>
          <DockPanel Margin="0,4,0,10">
            <TextBlock x:Name="FontSizeText" DockPanel.Dock="Right" Width="44" VerticalAlignment="Center" Text="20"/>
            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="42" Value="20" TickFrequency="1" ValueChanged="FontSizeSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Giãn dòng"/>
          <DockPanel Margin="0,4,0,10">
            <TextBlock x:Name="LineHeightText" DockPanel.Dock="Right" Width="44" VerticalAlignment="Center" Text="32"/>
            <Slider x:Name="LineHeightSlider" Minimum="20" Maximum="60" Value="32" TickFrequency="1" ValueChanged="LineHeightSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Nền đọc"/>
          <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged">
            <ComboBoxItem Content="Sáng"/>
            <ComboBoxItem Content="Tối"/>
            <ComboBoxItem Content="Sepia"/>
          </ComboBox>

          <TextBlock Text="Chế độ hiển thị"/>
          <ComboBox x:Name="ViewModeCombo" SelectionChanged="ViewModeCombo_SelectionChanged">
            <ComboBoxItem Content="Cuộn"/>
            <ComboBoxItem Content="1 trang"/>
            <ComboBoxItem Content="2 trang"/>
          </ComboBox>

          <TextBlock Text="Thiết lập font/hiển thị được nhớ riêng theo từng EPUB." Foreground="#777" TextWrapping="Wrap" Margin="0,8,0,12"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Sẵn sàng" VerticalAlignment="Center"/>
        <ProgressBar x:Name="Progress" Grid.Column="1" Minimum="0" Maximum="1" Height="10" Value="0" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
