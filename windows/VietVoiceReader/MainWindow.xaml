<Window x:Class="VietVoiceReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VietVoice Reader"
        Width="1440" Height="900"
        MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="White"
            BorderBrush="#E5E5E5"
            BorderThickness="0,0,0,1"
            Padding="8">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="OpenBookButton" Click="OpenBook_Click" Content="Mở EPUB"/>
          <Button x:Name="PrevChapterButton" Click="PrevChapter_Click" Content="← Chương"/>
          <Button x:Name="PlayButton" Click="Play_Click" Content="Đọc"/>
          <Button x:Name="StopButton" Click="Stop_Click" Content="Dừng"/>
          <Button x:Name="NextChapterButton" Click="NextChapter_Click" Content="Chương →"/>

          <Separator Margin="8,4" Width="1"/>

          <TextBlock Text="Trang" VerticalAlignment="Center" Margin="4,0,4,0"/>
          <TextBox x:Name="PageNumberBox"
                   Width="54"
                   Height="32"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   KeyDown="PageNumberBox_KeyDown"/>
          <Button Click="GoToPage_Click" Content="Đi" MinWidth="42"/>

          <Separator Margin="8,4" Width="1"/>

          <CheckBox x:Name="AutoNextCheckBox"
                    Content="Tự qua chương"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    Margin="4,0,8,0"/>

          <Button x:Name="FocusModeButton"
                  Click="FocusMode_Click"
                  Content="Tập trung"/>

          <Button x:Name="ExportButton"
                  Click="Export_Click"
                  Content="Xuất MP3"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right">
          <TextBlock x:Name="BookTitleText"
                     Text="Kéo EPUB vào đây để mở"
                     FontWeight="SemiBold"
                     FontSize="15"
                     VerticalAlignment="Center"
                     Margin="12,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid x:Name="ReaderLayoutGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="320"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="RightColumn" Width="310"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="LeftPane"
              Grid.Column="0"
              Background="White"
              BorderBrush="#E5E5E5"
              BorderThickness="0,0,1,0"
              Padding="8">
        <TabControl x:Name="LeftTabs"
                    BorderThickness="0"
                    Background="Transparent">
          <TabItem Header="Thư viện">
            <DockPanel Margin="4,8,4,4">
              <StackPanel DockPanel.Dock="Bottom"
                          Orientation="Horizontal"
                          Margin="0,8,0,0">
                <Button Click="ContinueBook_Click"
                        Content="Đọc tiếp"
                        MinWidth="88"/>
                <Button Click="RemoveFromLibrary_Click"
                        Content="Bỏ khỏi thư viện"
                        MinWidth="118"/>
              </StackPanel>

              <TextBlock DockPanel.Dock="Top"
                         Text="SÁCH GẦN ĐÂY"
                         FontWeight="Bold"
                         Foreground="#555"
                         Margin="6,2,6,8"/>

              <ListBox x:Name="LibraryList"
                       BorderThickness="0"
                       Background="Transparent"
                       MouseDoubleClick="LibraryList_MouseDoubleClick"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8"
                            Margin="0,0,0,6"
                            Background="#F7F7F8"
                            CornerRadius="8">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Author}"
                                   Foreground="#777"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastReadText}"
                                   Foreground="#4F6BED"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastOpenedText}"
                                   Foreground="#999"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Mục lục">
            <DockPanel Margin="4,8,4,4">
              <TextBlock DockPanel.Dock="Top"
                         Text="MỤC LỤC"
                         FontWeight="Bold"
                         Foreground="#555"
                         Margin="6,2,6,8"/>
              <ListBox x:Name="ChapterList"
                       SelectionChanged="ChapterList_SelectionChanged"
                       BorderThickness="0"
                       Background="Transparent"/>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>

      <Grid Grid.Column="1" Background="#ECECEF">
        <Border Margin="8"
                Background="White"
                BorderBrush="#DDDDDF"
                BorderThickness="1"
                CornerRadius="10">
          <TabControl x:Name="BookTabs"
                      Margin="0"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectionChanged="BookTabs_SelectionChanged"/>
        </Border>

        <TextBlock x:Name="EmptyHint"
                   Text="Kéo một hoặc nhiều file EPUB vào cửa sổ&#x0a;hoặc bấm “Mở EPUB”"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="22"
                   Foreground="#999"
                   IsHitTestVisible="False"/>
      </Grid>

      <ScrollViewer x:Name="RightPane"
                    Grid.Column="2"
                    Background="White"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <TextBlock Text="GIỌNG ĐỌC"
                     FontWeight="Bold"
                     Foreground="#555"/>
          <ComboBox x:Name="VoiceCombo"
                    SelectionChanged="VoiceCombo_SelectionChanged"/>
          <TextBlock x:Name="VoiceSourceText"
                     Foreground="#666"
                     TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal"
                      Margin="0,6,0,14">
            <Button x:Name="DownloadVoiceButton"
                    Click="DownloadVoice_Click"
                    Content="Tải giọng"/>
            <Button x:Name="RemoveVoiceButton"
                    Click="RemoveVoice_Click"
                    Content="Xóa model"/>
          </StackPanel>

          <TextBlock Text="Tốc độ đọc" FontWeight="SemiBold"/>
          <DockPanel Margin="0,4,0,12">
            <TextBlock x:Name="SpeedText"
                       DockPanel.Dock="Right"
                       Width="46"
                       Text="1.00x"
                       VerticalAlignment="Center"/>
            <Slider x:Name="SpeedSlider"
                    Minimum="0.65"
                    Maximum="1.7"
                    Value="1"
                    TickFrequency="0.05"
                    ValueChanged="SpeedSlider_ValueChanged"/>
          </DockPanel>

          <Separator Margin="0,4,0,12"/>

          <TextBlock Text="HIỂN THỊ"
                     FontWeight="Bold"
                     Foreground="#555"/>

          <TextBlock Text="Thu phóng vùng đọc" Margin="0,10,0,0"/>
          <DockPanel Margin="0,4,0,10">
            <TextBlock x:Name="ReaderZoomText"
                       DockPanel.Dock="Right"
                       Width="54"
                       Text="100%"
                       VerticalAlignment="Center"/>
            <Slider x:Name="ReaderZoomSlider"
                    Minimum="50"
                    Maximum="200"
                    Value="100"
                    TickFrequency="10"
                    ValueChanged="ReaderZoomSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Font chữ"/>
          <ComboBox x:Name="FontCombo"
                    SelectionChanged="FontCombo_SelectionChanged"/>
          <Button Click="ImportFont_Click"
                  Content="Nạp font .TTF / .OTF"
                  HorizontalAlignment="Left"/>

          <TextBlock Text="Cỡ chữ" Margin="0,12,0,0"/>
          <DockPanel Margin="0,4,0,10">
            <TextBlock x:Name="FontSizeText"
                       DockPanel.Dock="Right"
                       Width="44"
                       VerticalAlignment="Center"
                       Text="20"/>
            <Slider x:Name="FontSizeSlider"
                    Minimum="12"
                    Maximum="42"
                    Value="20"
                    TickFrequency="1"
                    ValueChanged="FontSizeSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Giãn dòng"/>
          <DockPanel Margin="0,4,0,10">
            <TextBlock x:Name="LineHeightText"
                       DockPanel.Dock="Right"
                       Width="44"
                       VerticalAlignment="Center"
                       Text="32"/>
            <Slider x:Name="LineHeightSlider"
                    Minimum="20"
                    Maximum="60"
                    Value="32"
                    TickFrequency="1"
                    ValueChanged="LineHeightSlider_ValueChanged"/>
          </DockPanel>

          <TextBlock Text="Nền đọc"/>
          <ComboBox x:Name="ThemeCombo"
                    SelectionChanged="ThemeCombo_SelectionChanged">
            <ComboBoxItem Content="Sáng"/>
            <ComboBoxItem Content="Tối"/>
            <ComboBoxItem Content="Sepia"/>
          </ComboBox>

          <TextBlock Text="Chế độ hiển thị"/>
          <ComboBox x:Name="ViewModeCombo"
                    SelectionChanged="ViewModeCombo_SelectionChanged">
            <ComboBoxItem Content="Cuộn"/>
            <ComboBoxItem Content="1 trang"/>
            <ComboBoxItem Content="2 trang"/>
          </ComboBox>

          <TextBlock Text="Ctrl + lăn chuột để zoom nhanh. Khi ở cuối chương, lăn tiếp xuống sẽ chuyển sang chương kế."
                     Foreground="#777"
                     TextWrapping="Wrap"
                     Margin="0,10,0,12"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2"
            Background="White"
            BorderBrush="#E5E5E5"
            BorderThickness="0,1,0,0"
            Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText"
                   Text="Sẵn sàng"
                   VerticalAlignment="Center"/>
        <ProgressBar x:Name="Progress"
                     Grid.Column="1"
                     Minimum="0"
                     Maximum="1"
                     Height="10"
                     Value="0"
                     VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
