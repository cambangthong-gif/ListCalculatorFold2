<Application
    x:Class="AladWindowsV5.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AladAccentBrush" Color="#0B73F6"/>
                    <SolidColorBrush x:Key="AladAccentSubtleBrush" Color="#140B73F6"/>
                    <SolidColorBrush x:Key="AladSuccessBrush" Color="#18A558"/>
                    <SolidColorBrush x:Key="AladWarningBrush" Color="#E79000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AladAccentBrush" Color="#0B73F6"/>
                    <SolidColorBrush x:Key="AladAccentSubtleBrush" Color="#140B73F6"/>
                    <SolidColorBrush x:Key="AladSuccessBrush" Color="#118846"/>
                    <SolidColorBrush x:Key="AladWarningBrush" Color="#C56D00"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AladAccentBrush" Color="#5FA8FF"/>
                    <SolidColorBrush x:Key="AladAccentSubtleBrush" Color="#245FA8FF"/>
                    <SolidColorBrush x:Key="AladSuccessBrush" Color="#4ED58B"/>
                    <SolidColorBrush x:Key="AladWarningBrush" Color="#FFB84D"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="20"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Opacity" Value="0.78"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
