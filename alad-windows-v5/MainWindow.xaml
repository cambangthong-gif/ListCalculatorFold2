<Window
    x:Class="AladWindowsV5.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ALAD">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1120" Padding="28,26,28,30" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <!-- Hero -->
                    <Grid Margin="2,0,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="72" CornerRadius="20" Background="{ThemeResource AladAccentSubtleBrush}">
                            <Image Source="Assets/alad.png" Width="58" Height="58" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,3,16,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="ALAD" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock Text="Lồng tiếng trực tiếp cho Windows" FontSize="15" Opacity="0.68"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="142" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="Theo Windows"/>
                            <ComboBoxItem Content="Sáng"/>
                            <ComboBoxItem Content="Tối"/>
                        </ComboBox>
                    </Grid>

                    <InfoBar x:Name="AlertBar" IsOpen="False" IsClosable="True" Severity="Informational"/>

                    <!-- Live status -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText" Text="Sẵn sàng" FontWeight="SemiBold" FontSize="16"/>
                                    <ProgressRing x:Name="ConnectRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <TextBlock x:Name="ModelText" Text="Gemini 3.5 Live Translate" Opacity="0.72"/>
                                    <TextBlock x:Name="InputText" Text="Audio vào: chờ" Opacity="0.72"/>
                                    <TextBlock x:Name="LatencyText" Text="Buffer 0 ms" Opacity="0.72"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{ThemeResource AladAccentSubtleBrush}" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                                <TextBlock x:Name="ModeBadge" Text="LOW LATENCY" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AladAccentBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Connection + audio source -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Kết nối" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel>
                                    <TextBlock Text="Gemini API key" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="ApiKeyBox" PasswordRevealMode="Peek" PlaceholderText="Nhập API key"/>
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="GetKeyButton" Content="Tạo / Lấy API key"/>
                                    <Button x:Name="PasteKeyButton" Grid.Column="1" Content="Dán key"/>
                                    <ToggleSwitch x:Name="RememberKeyToggle" Grid.Column="2" Header="Nhớ key" IsOn="True" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="Engine" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="EngineCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Dịch nhanh · Gemini 3.5 Live Translate" Tag="fast"/>
                                        <ComboBoxItem Content="Giọng tùy chọn · Gemini 3.8 Live" Tag="voice"/>
                                    </ComboBox>
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ngôn ngữ đích" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="LanguageCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="日本語" Tag="ja"/>
                                            <ComboBoxItem Content="한국어" Tag="ko"/>
                                            <ComboBoxItem Content="中文" Tag="zh"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Giọng AI" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="VoiceCombo" SelectedIndex="0" IsEnabled="False">
                                            <ComboBoxItem Content="Kore"/>
                                            <ComboBoxItem Content="Puck"/>
                                            <ComboBoxItem Content="Aoede"/>
                                            <ComboBoxItem Content="Charon"/>
                                            <ComboBoxItem Content="Fenrir"/>
                                            <ComboBoxItem Content="Leda"/>
                                            <ComboBoxItem Content="Orus"/>
                                            <ComboBoxItem Content="Zephyr"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Âm thanh" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel>
                                    <TextBlock Text="Nguồn âm thanh" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SourceCombo" MinWidth="260"/>
                                        <Button x:Name="RefreshSourceButton" Grid.Column="1" Content="Làm mới"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Kiểu lồng tiếng" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="MixCombo" SelectedIndex="0">
                                        <ComboBoxItem Content="Auto Ducking"/>
                                        <ComboBoxItem Content="Voice-over"/>
                                        <ComboBoxItem Content="Song song"/>
                                        <ComboBoxItem Content="Lồng hoàn toàn"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Âm lượng gốc"/>
                                        <TextBlock x:Name="OriginalVolumeValue" Text="100%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="OriginalVolumeSlider" Minimum="0" Maximum="100" Value="100" StepFrequency="1"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Âm lượng AI"/>
                                        <TextBlock x:Name="AiVolumeValue" Text="100%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="AiVolumeSlider" Minimum="0" Maximum="100" Value="100" StepFrequency="1"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Sync / advanced -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="Đồng bộ &amp; độ trễ" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock Text="Ưu tiên phát gần thời gian thực" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.62"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Bù đồng bộ (ms)" Style="{StaticResource FieldLabelStyle}"/>
                                    <NumberBox x:Name="SyncNumber" Minimum="-2000" Maximum="5000" SmallChange="100" Value="0" SpinButtonPlacementMode="Compact"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Bottom">
                                    <ToggleSwitch x:Name="AutoSyncToggle" Header="Auto Sync" IsOn="True"/>
                                    <ToggleSwitch x:Name="CatchUpToggle" Header="Catch-up" IsOn="True"/>
                                    <ToggleSwitch x:Name="LowLatencyToggle" Header="Low Latency" IsOn="True"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Transcript -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Bản chép lời" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <Button x:Name="ClearTranscriptButton" Content="Xóa" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBox x:Name="TranscriptBox" Height="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PlaceholderText="Nội dung nhận diện và bản dịch sẽ hiện ở đây khi model hỗ trợ transcription."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Sticky command bar -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="22,14">
            <Grid MaxWidth="1120" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterTitle" Text="Sẵn sàng để lồng tiếng" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FooterSubtitle" Text="Chọn nguồn âm thanh rồi bấm Bắt đầu" FontSize="12" Opacity="0.62"/>
                </StackPanel>
                <Button x:Name="StopButton" Grid.Column="1" Content="Dừng" MinWidth="110" Height="42" Margin="0,0,10,0" IsEnabled="False"/>
                <Button x:Name="StartButton" Grid.Column="2" Content="Bắt đầu lồng tiếng" MinWidth="190" Height="42" Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
